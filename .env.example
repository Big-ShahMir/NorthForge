# NorthForge environment configuration.
# Copy to .env and fill in values. Never commit .env.
# The API and worker read this file from the repository root.

# --- Application ---------------------------------------------------------
APP_ENV=development              # development | test | production
LOG_LEVEL=INFO
API_HOST=127.0.0.1
API_PORT=8000

# --- Durable dependencies (required) --------------------------------------
# Host ports published by docker-compose.yml. PostgreSQL defaults to 5433 so a
# locally installed PostgreSQL on 5432 does not intercept connections.
POSTGRES_PORT=5433
REDIS_PORT=6379
DATABASE_URL=postgresql://northforge:northforge@localhost:5433/northforge
REDIS_URL=redis://localhost:6379/0

# --- Readiness and worker liveness ----------------------------------------
WORKER_HEALTH_CHECK_INTERVAL_SECONDS=10   # worker heartbeat cadence
READINESS_TIMEOUT_SECONDS=2               # per-dependency probe timeout

# --- Authentication: Clerk (required from Phase 1) ------------------------
# Backend verifies session tokens; the publishable key is safe for the browser.
# AUTH_MODE=dev trusts an X-Dev-User request header instead of verifying a
# Clerk session token. It is for local development only and is rejected at
# startup when APP_ENV=production. AUTH_MODE=clerk (the default) requires
# CLERK_JWKS_URL and CLERK_ISSUER to be set.
AUTH_MODE=dev
CLERK_SECRET_KEY=
CLERK_JWKS_URL=
CLERK_ISSUER=                       # e.g. https://<slug>.clerk.accounts.dev
# Optional azp allowlist (frontend origins), JSON list or comma form, e.g.
CLERK_AUTHORIZED_PARTIES=          # comma-separated allowed azp origins, e.g. http://localhost:5173
VITE_CLERK_PUBLISHABLE_KEY=

# --- Model provider (Phase 4) ---------------------------------------------
# Backend only. Never expose to the frontend. Without NVIDIA_API_KEY the API
# and worker still start; every model call fails with PROVIDER_NOT_CONFIGURED
# and GET /api/provider-status reports configured=false.
# MODEL_PROVIDER=mock uses the scripted in-process provider (tests, offline
# demos); it is rejected when APP_ENV=production.
MODEL_PROVIDER=nvidia
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Reranking NIMs are served from a different host than the OpenAI-compatible API.
NVIDIA_RERANK_BASE_URL=https://ai.api.nvidia.com/v1
# Role -> model. Empty means "use default_routes in
# backend/northforge/providers/model_catalog.json" (currently the values shown).
# Every model must exist in the catalog with the capabilities its role needs;
# startup fails otherwise. Fallbacks are comma-separated and used only when
# the primary is rate-limited, unavailable, or times out.
NVIDIA_MODEL_PLANNER=                      # nvidia/nemotron-3-super-120b-a12b
NVIDIA_MODEL_EXTRACTION=                   # nvidia/nemotron-3.5-lightning-30b-a3b
NVIDIA_MODEL_DRAFTER=                      # moonshotai/kimi-k3
NVIDIA_MODEL_EVALUATOR=                    # deepseek-ai/deepseek-v4-flash-0731
NVIDIA_MODEL_PLANNER_FALLBACKS=
NVIDIA_MODEL_EXTRACTION_FALLBACKS=
NVIDIA_MODEL_DRAFTER_FALLBACKS=
NVIDIA_MODEL_EVALUATOR_FALLBACKS=
# Embedding and reranking providers: nvidia | mock | none (none disables the role).
EMBEDDING_PROVIDER=nvidia
EMBEDDING_MODEL=                           # nvidia/nemotron-3-embed-1b (2048 dims)
RERANKER_PROVIDER=nvidia
RERANKER_MODEL=                            # nvidia/llama-nemotron-rerank-vl-1b-v2
# Optional path to a catalog JSON that replaces the packaged one.
MODEL_CAPABILITIES_FILE=
# Resilience. The hosted free tier allows 40 requests/minute per key across all
# models, so keep provider concurrency low.
MODEL_REQUEST_TIMEOUT_SECONDS=60
MODEL_MAX_ATTEMPTS=3
MODEL_PROVIDER_CONCURRENCY=4
MODEL_PER_MODEL_CONCURRENCY=2
# Cache deterministic (temperature 0) requests in Redis. Empty = on except in production.
MODEL_CACHE_ENABLED=
MODEL_CACHE_TTL_SECONDS=86400

# --- Object storage: S3-compatible (MinIO locally) -------------------------
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=northforge
S3_ACCESS_KEY=northforge
S3_SECRET_KEY=northforge-secret
S3_REGION=us-east-1
S3_USE_SSL=false
